machine:
  kubelet:
    extraArgs:
      rotate-server-certificates: true # Required for metrics-server to ensure TLS validation due to error "cannot validate certificate because it doesn't contain any IP SANs"
  nodeLabels:
    topology.kubernetes.io/region: ${cluster_name}
    topology.kubernetes.io/zone: ${node_name}

cluster:
  allowSchedulingOnControlPlanes: false
  network:
    cni:
      name: none
  proxy:
    disabled: true
  # Gateway API CRDs must exist before Cilium starts so the GatewayClass is accepted.
  # Standard channel bundle; keep the version in step with kubernetes/core/crds and
  # with what Cilium supports.
  extraManifests:
    - https://raw.githubusercontent.com/alex1989hu/kubelet-serving-cert-approver/v0.8.4/deploy/standalone-install.yaml # renovate: github-releases=alex1989hu/kubelet-serving-cert-approver
    - https://github.com/kubernetes-sigs/metrics-server/releases/download/v0.7.2/components.yaml # renovate: github-releases=kubernetes-sigs/metrics-server
    - https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.6.3/standard-install.yaml # renovate: github-releases=kubernetes-sigs/gateway-api
  inlineManifests:
  - name: cilium-values
    contents: |
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: cilium-values
        namespace: kube-system
      data:
        values.yaml: |-
          ${indent(10, cilium_values)}
  - name: cilium-bootstrap
    contents: |
      ${indent(6, cilium_install)}
