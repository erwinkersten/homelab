proxmox = {
  endpoint     = "https://yourproxmoxdnsname:8006" # no trailing slash
  username     = "root@pam"
  password     = "password"
  insecure     = false # set to true for self-signed certificates
  api_token    = "example-api-token"
  cluster_name = "homelab"
}

# Obtain these values by running: ./tofu-images.sh prod
# The file_id comes from images["<label>"].file_ids["<proxmox_node>"]
# The installer_image comes from images["<label>"].installer_image
image = {
  file_id         = "data:iso/talos-<schematic-id>-v1.9.1-nocloud-amd64.img"
  update_file_id  = null # set to the upgrade image file_id when upgrading nodes
  installer_image = null # target for talos-upgrade.sh, e.g. "factory.talos.dev/nocloud-installer/<schematic-id>:v1.14.5"
}

cluster = {
  name            = "clustername.local"  # Cluster name
  environment     = "prod"               # Used to locate config files under config/prod/
  endpoint        = "10.10.10.100"       # Cluster endpoint (IP or DNS)
  gateway         = "10.10.10.1"         # Gateway IP
  cidr            = 20                   # Subnet prefix length
  proxmox_cluster = "homelab"            # Proxmox cluster name
  # Versions the nodes run. Renovate keeps these at the latest releases, which is fine for
  # a new cluster. For an existing cluster, set them to what the nodes run and let
  # talos-upgrade.sh move them up one minor version at a time.
  # talos_version needs a matching entry in images.<env>.tfvars (tofu-images.sh downloads it).
  # kubernetes_version must be supported by that Talos release, see
  # https://docs.siderolabs.com/talos/latest/getting-started/support-matrix
  talos_version      = "v1.14.5" # renovate: github-releases=siderolabs/talos
  kubernetes_version = "1.37.2" # renovate: github-releases=kubernetes/kubernetes extractVersion=^v(?<version>.+)$

  # Machine configuration format OpenTofu generates (the Talos provider's version contract).
  # Not updated by Renovate on purpose. Keep it pinned; nodes accept an older format.
  # From v1.14 the generated config uses a new multi-document format that the templates in
  # talos/machine-config/ are not migrated to yet, so keep it at v1.13.x or lower for now.
  # Must not be newer than talos_version.
  talos_config_version = "v1.13.3"

  bootstrap_node = "10.10.10.110" # IP of the control plane node used for bootstrap
}

# Nodes to be provisioned in the Kubernetes cluster.
# Upgrade nodes with ./talos-upgrade.sh, which reads this block and image.installer_image.
# update = true still triggers an upgrade through upgrade-node.sh during tofu-deploy.sh,
# but nodes of the same type can then upgrade in parallel.
nodes = {
  "k8-prod-ctrl-00" = {
    machine_type  = "controlplane"
    #update        = true
    ip            = "10.10.10.110"
    cidr          = 20
    gateway       = "10.10.10.1"
    cpu           = 2
    disk_size     = 20
    ram_dedicated = 4096
    host_node     = "pve-01"
    vm_id         = 500
    datastore_id  = "ssd"
  }
  "k8-prod-work-00" = {
    machine_type  = "worker"
    #update        = true
    ip            = "10.10.10.113"
    cidr          = 20
    gateway       = "10.10.10.1"
    cpu           = 2
    disk_size     = 20
    ram_dedicated = 16384
    host_node     = "pve-01"
    vm_id         = 503
    datastore_id  = "nvme"
  }
}

